{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "lib": ["ES2024", "DOM"],
    "types": ["node", "vite/client"],
    "allowJs": true,
    "checkJs": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "tests/*.test.ts", "tests/e2e", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "playwright.entry.config.ts"]
}
