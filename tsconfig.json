{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "architecture/frontend.mjs",
    "vitest.config.mjs",
    "tooling/*.mjs",
    "tests/node/frontend-coverage.test.mjs",
    "tests/frontend-toolchain/*.mjs"
  ]
}
