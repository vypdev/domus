{
  "name": "domus-development",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "test:architecture": "vitest run tests/node/architecture.test.mjs --coverage",
    "check": "tsc --noEmit --project tsconfig.json",
    "check:frontend": "pnpm --filter @domus/frontend check",
    "build:frontend": "pnpm --filter @domus/frontend build",
    "build:frontend-catalog": "pnpm --filter @domus/frontend storybook:build",
    "test:frontend-catalog": "pnpm --filter @domus/frontend browser:catalog",
    "test:frontend-entry": "pnpm --filter @domus/frontend browser:entry",
    "test:frontend": "pnpm --filter @domus/frontend test && node --test tests/frontend/coverage-evidence.test.mjs",
    "check:frontend-toolchain": "pnpm --filter @domus/frontend-toolchain check",
    "test:frontend-toolchain": "pnpm --filter @domus/frontend-toolchain test",
    "build:frontend-toolchain": "pnpm --filter @domus/frontend-toolchain build && pnpm --filter @domus/frontend-toolchain storybook:build",
    "test:frontend-browser": "pnpm --filter @domus/frontend-toolchain browser",
    "test:frontend-guards": "node --test --test-concurrency=1 tests/frontend-toolchain/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
